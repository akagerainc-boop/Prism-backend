# ===========================================================================
# Prism Scanner backend -- environment template
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS/Linux)
#
# Then fill in the values marked REQUIRED. Never commit the real .env.
# ===========================================================================

# ---- App -------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- MySQL (XAMPP) ---------------------------------------------------------
# Start MySQL in the XAMPP Control Panel, then import schema.sql via phpMyAdmin
# (http://localhost/phpmyadmin) or: mysql -u root -p < schema.sql
#
# A default XAMPP install has user "root" with an EMPTY password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=prism

# Optional: a full SQLAlchemy DSN that overrides all of the above.
# MYSQL_DSN=mysql+pymysql://root:@127.0.0.1:3306/prism?charset=utf8mb4

# Log every SQL statement (noisy -- debugging only).
SQL_ECHO=false

# ---- Session tokens (REQUIRED) ---------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every existing session.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# ---- OTP behaviour ---------------------------------------------------------
OTP_LENGTH=5
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MIN_INTERVAL_SECONDS=60
OTP_MAX_PER_HOUR=5

# ---- Email delivery --------------------------------------------------------
# Use "resend" on Render because outbound Gmail SMTP is blocked there.
EMAIL_PROVIDER=resend
EMAIL_FROM=Prism Scanner <onboarding@resend.dev>
RESEND_API_KEY=

# ---- Gmail SMTP (REQUIRED for real OTP delivery) ---------------------------
# SMTP_APP_PASSWORD must be a Gmail APP PASSWORD (16 characters), NOT the normal
# account password. See README.md -> "Getting a Gmail App Password".
# Paste it without spaces: Google displays it as "abcd efgh ijkl mnop".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=akagerainc@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Prism Scanner
SMTP_TIMEOUT_SECONDS=20

# Set true to LOG the OTP instead of emailing it -- lets you test the whole auth
# flow before the App Password exists. Never enable this in production.
SMTP_DEV_MODE=false

# ---- Storage ---------------------------------------------------------------
# Where uploaded PDFs and OCR job artifacts live. Defaults to backend/storage.
PRISM_STORAGE_ROOT=
MAX_UPLOAD_BYTES=104857600
# Resize very large camera images before OCR to reduce CPU/GPU and memory load.
MAX_OCR_IMAGE_DIMENSION=2200

# ---- Document scanning -----------------------------------------------------
# OpenCV-Document-Scanner performs document detection and produces a clean scan.

# Optional TTF for searchable-PDF export of non-Latin text (CJK, Cyrillic, ...).
# Without it the built-in Helvetica is used, which is Latin-1 only.
# PDF_UNICODE_FONT_PATH=C:\Windows\Fonts\arial.ttf

# ---- Passport photo --------------------------------------------------------
# rembg model. u2net_human_seg is portrait-tuned; u2net is the generic default.
REMBG_MODEL=u2net_human_seg
PASSPORT_MIN_SUBJECT_RATIO=0.03
PASSPORT_MAX_SUBJECT_RATIO=0.97
PASSPORT_JPEG_QUALITY=95

# ---- CORS ------------------------------------------------------------------
# "*" or a comma-separated origin list.
CORS_ALLOW_ORIGINS=*

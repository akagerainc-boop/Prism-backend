__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PaddleOCR downloads model weights into the user's home by default, but pin
# them here too in case PADDLE_PDX_CACHE_HOME points into the project.
.paddlex/


